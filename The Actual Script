local function lerpColor(c1, c2, t)
    return Color3.new(
        c1.R + (c2.R - c1.R) * t,
        c1.G + (c2.G - c1.G) * t,
        c1.B + (c2.B - c1.B) * t
    )
end

-- Safe animation loop
connect(RunService.Heartbeat, function(dt)
    if not themeAnimationActive or not currentTheme then return end
    
    themeAnimTime = themeAnimTime + dt * (currentTheme.animSpeed or 2)
    local t = (math.sin(themeAnimTime) + 1) / 2
    local animColor = lerpColor(currentTheme.primary1, currentTheme.primary2, t)
    
    -- Clean up dead elements and animate live ones
    local toRemove = {}
    for element, elementType in pairs(animatedElements) do
        if element and typeof(element) == "Instance" and element.Parent then
            local success = pcall(function()
                if elementType == "background" then
                    element.BackgroundColor3 = animColor
                elseif elementType == "text" then
                    element.TextColor3 = animColor
                elseif elementType == "stroke" then
                    element.Color = animColor
                end
            end)
            if not success then
                table.insert(toRemove, element)
            end
        else
            table.insert(toRemove, element)
        end
    end
    
    -- Remove dead elements
    for _, el in ipairs(toRemove) do
        animatedElements[el] = nil
    end
end)

