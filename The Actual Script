--==================================================
-- INPUT HANDLING
--==================================================

connect(UserInputService.InputBegan, function(input, gpe)
    if waitingForKeybind and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
        if waitingForKeybind == "_LockCamToggle" then
            lockCamToggleKeybind = input.KeyCode
            waitingForKeybind = nil
            refreshAllUI()
            return
        end
        keybinds[waitingForKeybind] = input.KeyCode
        waitingForKeybind = nil
        refreshAllUI()
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    -- Check if user is typing in a text box
    local isTyping = UserInputService:GetFocusedTextBox() ~= nil
    
    local kc = input.KeyCode
    
    -- Custom shiftlock toggle with configurable key (only if keybind is enabled)
    -- Shiftlock works even when typing (like Roblox's built-in)
    if kc == keybinds.ShiftLock and shiftlockKeyEnabled and not gpe and not isTyping then 
        toggleCustomShiftlock()
        refreshAllUI()
    end
    
    if gpe or isTyping then return end
    
    -- These only work when NOT typing
    if kc == keybinds.ReverseLock and reverseLockEnabled then reverseLockHeld = true end
    if kc == keybinds.LockOnPlus and lockOnPlusEnabled then lockOnPlusHeld = true end
    if kc == lockCamToggleKeybind and lockCamToggleEnabled then
        if lockCamToggleMode == "Hold" then lockCamToggleActive = true
        else lockCamToggleActive = not lockCamToggleActive end
    end
    
    if kc == keybinds.LockOn then
        if lockedOn then 
            if camera then lastLookDir = camera.CFrame.LookVector end
            unlockCamera(true)
        else 
            -- Use mouse target mode if enabled, otherwise use closest target
            local t, ty
            if mouseTargetMode then
                t, ty = findMouseTarget()
            else
                t, ty = findBestTargetCombined(nil)
            end
            if t then setNewTarget(t, ty) end 
        end
    end
    if kc == keybinds.SwapTarget and lockedOn and currentTarget then 
        -- Swap also uses mouse target mode if enabled
        local t, ty
        if mouseTargetMode then
            t, ty = findMouseTarget()
            -- If mouse target is same as current, find next closest
            if t == currentTarget then
                t, ty = findBestTargetCombined(currentTarget)
            end
        else
            t, ty = findBestTargetCombined(currentTarget)
        end
        if t then setNewTarget(t, ty) end 
    end
    
    -- Game-specific function triggers
    if selectedGame and lockedOn and currentTarget then
        -- JJS Nanami Perfect Special (R key)
        if kc == Enum.KeyCode.R then
            for i, func in ipairs(selectedGame.functions) do
                if func.name == "Nanami Perfect Special" and gameFunctionStates[func.name] then
                    func.execute(currentTarget)
                end
            end
        end
    end

end)

connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == keybinds.ReverseLock then reverseLockHeld = false end
        if input.KeyCode == lockCamToggleKeybind and lockCamToggleEnabled and lockCamToggleMode == "Hold" then lockCamToggleActive = false end
        if input.KeyCode == keybinds.LockOnPlus then 
            lockOnPlusHeld = false
            -- Re-enable AutoRotate when released
            local myChar = localPlayer.Character
            if myChar then
                local myHum = myChar:FindFirstChildOfClass("Humanoid")
                if myHum then myHum.AutoRotate = true end
            end
        end
    end
end)

