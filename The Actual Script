local function onCharacterAdded(char)
    pcall(function()
        char:WaitForChild("Humanoid", 10)
        char:WaitForChild("HumanoidRootPart", 10)
    end)
    
    -- Reset lock state
    if lockedOn then 
        lockedOn, currentTarget, currentTargetType = false, nil, "player" 
    end
    
    -- Update camera reference
    camera = workspace.CurrentCamera
    
    -- Store current visual settings before destroying
    local savedHighlight = false
    local savedHighlight2 = false
    local savedSelfFade = false
    
    if visuals then
        pcall(function()
            savedHighlight = visuals:IsHighlightEnabled()
            savedHighlight2 = visuals:IsHighlightSecondEnabled()
            savedSelfFade = visuals:IsSelfFadeEnabled()
        end)
        pcall(function() visuals:Destroy() end)
    end
    
    -- Small delay to ensure character is fully loaded
    task.delay(0.5, function()
        -- Recreate visuals module
        if VisualModule then
            visuals = VisualModule.new(localPlayer)
            
            -- Restore saved settings
            if visuals then
                pcall(function()
                    visuals:SetHighlightEnabled(savedHighlight)
                    visuals:SetHighlightSecondEnabled(savedHighlight2)
                    visuals:SetSelfFadeEnabled(savedSelfFade)
                end)
            end
        end
        
        -- Re-enable custom shiftlock if it was on
        if customShiftlockEnabled then
            -- Force re-enable (reset the flag first so enable actually runs)
            customShiftlockEnabled = false
            enableCustomShiftlock()
        end
        
        -- Update NPC highlight if needed
        updateNPCHighlight()
        
        -- Refresh UI to show correct states
        refreshAllUI()
    end)
end

