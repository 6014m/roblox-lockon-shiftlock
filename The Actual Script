connect(localPlayer.OnTeleport, function(state)
    tpDebug("OnTeleport fired - State: " .. tostring(state))
    
    if state == Enum.TeleportState.Started then 
        tpDebug("TeleportState.Started detected!")
        
        -- Save settings before teleport
        pcall(saveSettings)
        tpDebug("Settings saved")
        
        -- METHOD 2: Queue script when teleport starts (Synapse X style)
        -- Some executors need this instead of/in addition to startup queue
        if queueteleport and SCRIPT_URL then
            local success, err = pcall(function()
                queueteleport([[
                    repeat task.wait() until game:IsLoaded()
                    task.wait(2)
                    local success, err = pcall(function()
                        loadstring(game:HttpGet("]] .. SCRIPT_URL .. [[", true))()
                    end)
                    if not success then
                        warn("[LockOn] Re-execute failed: " .. tostring(err))
                    end
                ]])
            end)
            
            if success then
                tpDebug("METHOD 2: Queued in OnTeleport - SUCCESS")
            else
                tpDebug("METHOD 2: Queued in OnTeleport - FAILED: " .. tostring(err))
            end
        else
            if not queueteleport then
                tpDebug("METHOD 2: Skipped - no queue_on_teleport function")
            elseif not SCRIPT_URL then
                tpDebug("METHOD 2: Skipped - no SCRIPT_URL set")
            end
        end
    end
end)

