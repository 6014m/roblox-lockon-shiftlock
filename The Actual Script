    end
    pcall(function() rebuildFriendsList() end)
end

local function stopTeamsMode()
    if teamsModeConnection then
        pcall(function() teamsModeConnection:Disconnect() end)
        teamsModeConnection = nil
    end
    for _, conn in ipairs(teamsPlayerConnections) do
        pcall(function() conn:Disconnect() end)
    end
    teamsPlayerConnections = {}
end

local function startTeamsMode()
    stopTeamsMode()
    syncTeamFriendlies()

    teamsModeConnection = connect(localPlayer:GetPropertyChangedSignal("Team"), function()
        syncTeamFriendlies()
    end)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            local conn = connect(plr:GetPropertyChangedSignal("Team"), function()
                syncTeamFriendlies()
            end)
            table.insert(teamsPlayerConnections, conn)
        end
    end

    local addConn = connect(Players.PlayerAdded, function(plr)
        local conn = connect(plr:GetPropertyChangedSignal("Team"), function()
            syncTeamFriendlies()
        end)
        table.insert(teamsPlayerConnections, conn)
        syncTeamFriendlies()
    end)
    table.insert(teamsPlayerConnections, addConn)

    local removeConn = connect(Players.PlayerRemoving, function()
        syncTeamFriendlies()
    end)
    table.insert(teamsPlayerConnections, removeConn)
end

