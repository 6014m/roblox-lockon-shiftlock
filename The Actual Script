--==================================================

local function isNPC(model)
    if not model:IsA("Model") then return false end
    local hum, root = getHumanoid(model), getRootPart(model)
    if not hum or not root then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return false end
    end
    return model ~= localPlayer.Character
end

local function searchForNPCs(container, npcs, myRoot, depth)
    if depth > 4 then return end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Model") and isNPC(child) and isValidTarget(child) then
            local root = getRootPart(child)
            if root then
                local dist = (root.Position - myRoot.Position).Magnitude
                if rangeLimit == 0 or dist <= rangeLimit then
                    table.insert(npcs, {model = child, distance = dist})
                end
            end
        end
        if child:IsA("Folder") or child:IsA("Model") then
            local name = child.Name:lower()
            if not (name == "camera" or name == "terrain" or name == "lighting" or name == "chat" or name == "sounds") then
                searchForNPCs(child, npcs, myRoot, depth + 1)
            end
        end
    end
end

local function findNPCsNow()
    local npcs, myRoot = {}, getRootPart(localPlayer.Character)
    if not myRoot then return npcs end
    searchForNPCs(workspace, npcs, myRoot, 0)
    table.sort(npcs, function(a, b) return a.distance < b.distance end)
    return npcs
end

local function updateNPCHighlight()
    if npcHighlight then pcall(function() npcHighlight:Destroy() end); npcHighlight = nil end
    if currentTargetType == "npc" and currentTarget and visuals and visuals:IsHighlightEnabled() then
        npcHighlight = Instance.new("Highlight")
        npcHighlight.FillColor = currentTheme.primary1
        npcHighlight.OutlineColor = currentTheme.glow
        npcHighlight.FillTransparency = 0.5
        npcHighlight.OutlineTransparency = 0
        npcHighlight.Adornee = currentTarget
        npcHighlight.Parent = currentTarget
    end
end

