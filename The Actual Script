    connect(el.MouseEnter, function()
        currentHover = el
        if tooltipsEnabled and tooltipLabel then 
            tooltipLabel.Text = txt
            tooltipLabel.Visible = true 
        end
    end)
    connect(el.MouseLeave, function()
        if currentHover == el then 
            currentHover = nil
            if tooltipLabel then tooltipLabel.Visible = false end 
        end
    end)
end

