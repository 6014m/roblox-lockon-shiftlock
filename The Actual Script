--==================================================
-- INPUT HANDLING
--==================================================

connect(UserInputService.InputBegan, function(input, gpe)
    if waitingForKeybind and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
        keybinds[waitingForKeybind] = input.KeyCode
        waitingForKeybind = nil
        refreshAllUI()
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local kc = input.KeyCode
    if kc == keybinds.ReverseLock and reverseLockEnabled then reverseLockHeld = true end
    if kc == keybinds.LockOnPlus and lockOnPlusEnabled then lockOnPlusHeld = true end
    
    -- Custom shiftlock toggle with configurable key (only if keybind is enabled)
    if kc == keybinds.ShiftLock and shiftlockKeyEnabled then 
        toggleCustomShiftlock()
        refreshAllUI()
    end
    
    if gpe then return end
    if kc == keybinds.LockOn then
        if lockedOn then 
            if camera then lastLookDir = camera.CFrame.LookVector end
            unlockCamera(true)
        else 
            -- Use mouse target mode if enabled, otherwise use closest target
            local t, ty
            if mouseTargetMode then
                t, ty = findMouseTarget()
            else
                t, ty = findBestTargetCombined(nil)
            end
            if t then setNewTarget(t, ty) end 
        end
    end
    if kc == keybinds.SwapTarget and lockedOn and currentTarget then 
        -- Swap also uses mouse target mode if enabled
        local t, ty
        if mouseTargetMode then
            t, ty = findMouseTarget()
            -- If mouse target is same as current, find next closest
            if t == currentTarget then
                t, ty = findBestTargetCombined(currentTarget)
            end
        else
            t, ty = findBestTargetCombined(currentTarget)
        end
        if t then setNewTarget(t, ty) end 
    end

end)

connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == keybinds.ReverseLock then reverseLockHeld = false end
        if input.KeyCode == keybinds.LockOnPlus then 
            lockOnPlusHeld = false
            -- Re-enable AutoRotate when released
            local myChar = localPlayer.Character
            if myChar then
                local myHum = myChar:FindFirstChildOfClass("Humanoid")
                if myHum then myHum.AutoRotate = true end
            end
        end
    end
end)

