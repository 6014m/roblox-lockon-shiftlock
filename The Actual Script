local LOCKON_PLUS_BIND = "LockOnPlusCharRotation"

local function updateLockOnPlusRotation()
    -- Only run if enabled, held, and locked onto someone
    if not lockOnPlusEnabled or not lockOnPlusHeld or not lockedOn or not currentTarget then
        return
    end
    
    local myChar = localPlayer.Character
    if not myChar then return end
    
    local myRoot = getRootPart(myChar)
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum then return end
    
    -- Get target position
    local targetChar = (currentTargetType == "player") and (currentTarget and currentTarget.Character) or currentTarget
    local targetRoot = getRootPart(targetChar)
    if not targetRoot then return end
    
    -- Calculate direction from player to target (Y axis only)
    local targetPos = targetRoot.Position
    local myPos = myRoot.Position
    local direction = (targetPos - myPos)
    local flatDirection = Vector3.new(direction.X, 0, direction.Z)
    
    if flatDirection.Magnitude < 0.1 then return end
    
    -- Disable AutoRotate to take manual control
    myHum.AutoRotate = false
    
    -- Calculate the Y rotation angle
    local targetCFrame = CFrame.lookAt(myPos, myPos + flatDirection)
    local _, yAngle, _ = targetCFrame:ToEulerAnglesYXZ()
    
    -- Apply rotation (only Y axis, preserve position)
    myRoot.CFrame = CFrame.new(myRoot.Position) * CFrame.Angles(0, yAngle, 0)
end

-- AlignOrientation for physics-based rotation (handles fast dashes better)
local lockOnPlusAlign = nil
local lockOnPlusAttachment = nil

local function setupLockOnPlusConstraint()
    local myChar = localPlayer.Character
    if not myChar then return end
    local myRoot = getRootPart(myChar)
    if not myRoot then return end
    
    -- Create attachment if needed
    if not lockOnPlusAttachment or not lockOnPlusAttachment.Parent then
        lockOnPlusAttachment = Instance.new("Attachment")
        lockOnPlusAttachment.Name = "LockOnPlusAttachment"
        lockOnPlusAttachment.Parent = myRoot
    end
    
    -- Create AlignOrientation if needed
    if not lockOnPlusAlign or not lockOnPlusAlign.Parent then
        lockOnPlusAlign = Instance.new("AlignOrientation")
        lockOnPlusAlign.Name = "LockOnPlusAlign"
        lockOnPlusAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
        lockOnPlusAlign.Attachment0 = lockOnPlusAttachment
        lockOnPlusAlign.RigidityEnabled = true -- Instant snap
        lockOnPlusAlign.Responsiveness = 200 -- Very high responsiveness
        lockOnPlusAlign.MaxTorque = math.huge
        lockOnPlusAlign.Parent = myRoot
    end
end

local function updateLockOnPlusAlignOrientation()
    if not lockOnPlusEnabled or not lockOnPlusHeld or not lockedOn or not currentTarget then
        -- Disable constraint when not in use
        if lockOnPlusAlign then lockOnPlusAlign.Enabled = false end
        return
    end
    
    local myChar = localPlayer.Character
    if not myChar then return end
    local myRoot = getRootPart(myChar)
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum then return end
    
    local targetChar = (currentTargetType == "player") and (currentTarget and currentTarget.Character) or currentTarget
    local targetRoot = getRootPart(targetChar)
    if not targetRoot then return end
    
    local targetPos = targetRoot.Position
    local myPos = myRoot.Position
    local direction = (targetPos - myPos)
    local flatDirection = Vector3.new(direction.X, 0, direction.Z)
    
    if flatDirection.Magnitude < 0.1 then return end
    
    myHum.AutoRotate = false
    
    -- Setup constraint if needed
    setupLockOnPlusConstraint()
    
    if lockOnPlusAlign then
        lockOnPlusAlign.Enabled = true
        lockOnPlusAlign.CFrame = CFrame.lookAt(Vector3.zero, flatDirection)
    end
end

