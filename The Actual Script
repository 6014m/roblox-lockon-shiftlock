    local genv = getgenv and getgenv() or _G
    
    -- Only queue once per session to avoid duplicates
    if not genv.LOCKON_STARTUP_QUEUED then
        genv.LOCKON_STARTUP_QUEUED = true
        
        local success, err = pcall(function()
            queueteleport([[
                repeat task.wait() until game:IsLoaded()
                task.wait(2)
                local success, err = pcall(function()
                    loadstring(game:HttpGet("]] .. SCRIPT_URL .. [[", true))()
                end)
                if not success then
                    warn("[LockOn] Re-execute failed: " .. tostring(err))
                end
            ]])
        end)
        
        if success then
            tpDebug("METHOD 1: Queued at startup - SUCCESS")
        else
            tpDebug("METHOD 1: Queued at startup - FAILED: " .. tostring(err))
        end
    else
        tpDebug("METHOD 1: Already queued this session, skipping")
    end
end

--==================================================
-- CLEANUP OLD INSTANCE & PREVENT DUPLICATES
--==================================================

local SCRIPT_KEY = "LOCKON_CAMERA_V3"

-- Store connections to disconnect on cleanup
local allConnections = {}

local function cleanupOldInstance()
    local genv = getgenv and getgenv() or _G
    if genv[SCRIPT_KEY] then
        local old = genv[SCRIPT_KEY]
        
        -- Disconnect all old connections first
        if old.Connections then
            for _, conn in ipairs(old.Connections) do
                pcall(function() conn:Disconnect() end)
            end
        end
        
        -- Call cleanup
        if old.Cleanup then 
            pcall(old.Cleanup) 
        end
        
        -- Destroy GUI
        if old.Gui then 
            pcall(function() old.Gui:Destroy() end) 
        end
        
        -- Unbind render step
        if old.BindName then 
            pcall(function() game:GetService("RunService"):UnbindFromRenderStep(old.BindName) end) 
        end
        
        genv[SCRIPT_KEY] = nil
    end
    
    -- Also clean any lingering GUIs by name pattern
    pcall(function()
        for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name:find("LockOn") then 
                gui:Destroy() 
            end
        end
    end)
    
    pcall(function()
        local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
        if pg then 
            for _, gui in ipairs(pg:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name:find("LockOn") then 
                    gui:Destroy() 
                end
            end 
        end
    end)
    
    -- Clean hidden UI if available
    pcall(function()
        if gethui then
            for _, gui in ipairs(gethui():GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name:find("LockOn") then 
                    gui:Destroy() 
                end
            end
        end
    end)
end

