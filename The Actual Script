-- Track target's character respawn to refresh highlights
local targetCharConn = nil

local function unlockCamera(manual)
    -- Disconnect target listener
    if targetCharConn then
        pcall(function() targetCharConn:Disconnect() end)
        targetCharConn = nil
    end
    
    lockedOn, currentTarget, currentTargetType = false, nil, "player"
    lockCamToggleActive = false
    pcall(function() camera.CameraType = prevCameraType end)
    invisibleTime = 0
    autoRelockPending = not manual and autoRelockEnabled
    updateNPCHighlight()
end

local function setNewTarget(target, tType)
    -- Disconnect old target listener
    if targetCharConn then
        pcall(function() targetCharConn:Disconnect() end)
        targetCharConn = nil
    end
    
    currentTarget, currentTargetType, lockedOn, invisibleTime = target, tType or "player", true, 0
    local char = (currentTargetType == "player") and target.Character or target
    local root = getRootPart(char)
    if root and camera then 
        local d = (root.Position - camera.CFrame.Position)
        if d.Magnitude > 0 then lastLookDir = d.Unit end 
    end
    updateNPCHighlight()
    
    -- Listen for target's character respawn (player targets only)
    if currentTargetType == "player" and target then
        targetCharConn = target.CharacterAdded:Connect(function(newChar)
            -- Wait for character to load
            task.delay(0.3, function()
                if lockedOn and currentTarget == target then
                    -- Refresh visuals for the new character
                    refreshVisuals()
                end
            end)
        end)
        table.insert(allConnections, targetCharConn)
    end
end

local function getBestTarget(exclude) return targeting and targeting:GetBestTarget(exclude) end

-- Find target closest to mouse cursor
local function findMouseTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local myRoot = getRootPart(localPlayer.Character)
    if not myRoot or not camera then return nil, nil end
    
    local best, bestType, bestDist = nil, nil, math.huge
    
    -- Check players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and not isFriendly(plr) then
            local char = plr.Character
            local root = getRootPart(char)
            if root and isValidTarget(char) then
                -- Get screen position of target
                local screenPos, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    local worldDist = (root.Position - myRoot.Position).Magnitude
                    
                    -- Check range limit
                    if rangeLimit == 0 or worldDist <= rangeLimit then
                        -- Check realistic mode (front only)
                        local valid = true
                        if realisticEnabled then
                            local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                            if dot < 0 then valid = false end
                        end
                        
                        if valid and screenDist < bestDist then
                            bestDist, best, bestType = screenDist, plr, "player"
                        end
                    end
                end
            end
        end
    end
    
    -- Check NPCs if enabled
    if npcModeEnabled then
        for _, data in ipairs(findNPCsNow()) do
            local root = getRootPart(data.model)
            if root then
                local screenPos, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    local valid = true
                    if realisticEnabled then
                        local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                        if dot < 0 then valid = false end
                    end
                    
                    if valid and screenDist < bestDist then
                        bestDist, best, bestType = screenDist, data.model, "npc"
                    end
                end
            end
        end
    end
    
    return best, bestType
end

local function findBestTargetCombined(exclude)
    local myRoot = getRootPart(localPlayer.Character)
    if not myRoot then return nil, nil end
    local best, bestType, bestDist = nil, nil, math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr ~= exclude and not isFriendly(plr) then
            local char, root = plr.Character, getRootPart(plr.Character)
            if root and isValidTarget(char) then
                local dist = (root.Position - myRoot.Position).Magnitude
                if (rangeLimit == 0 or dist <= rangeLimit) and dist < bestDist then
                    local valid = true
                    if realisticEnabled then
                        local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                        if dot < 0 then valid = false end
                    end
                    if valid then bestDist, best, bestType = dist, plr, "player" end
                end
            end
        end
    end
    
    if npcModeEnabled then
        for _, data in ipairs(findNPCsNow()) do
            if data.model ~= exclude and data.distance < bestDist then
                local root = getRootPart(data.model)
                if root and (not realisticEnabled or (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector) >= 0) then
                    bestDist, best, bestType = data.distance, data.model, "npc"
                end
            end
        end
    end
    
    return best, bestType
end

-- Cache for second closest target to prevent flickering
local cachedSecondTarget = nil
local cachedSecondTime = 0
local SECOND_TARGET_CACHE_TIME = 0.5 -- Only update every 0.5 seconds

local function getCachedSecondTarget(exclude)
    local now = tick()
    
    -- If cache is still valid and cached target still exists/valid, use it
    if cachedSecondTarget and (now - cachedSecondTime) < SECOND_TARGET_CACHE_TIME then
        -- Verify cached target is still valid
        if cachedSecondTarget ~= exclude then
            local char = cachedSecondTarget.Character
            if char and getRootPart(char) then
                return cachedSecondTarget
            end
        end
    end
    
    -- Cache expired or invalid, get new target
    local newTarget = getBestTarget(exclude)
    
    -- Only update cache if target changed significantly or cache expired
    if newTarget ~= cachedSecondTarget or (now - cachedSecondTime) >= SECOND_TARGET_CACHE_TIME then
        cachedSecondTarget = newTarget
        cachedSecondTime = now
    end
    
    return cachedSecondTarget
end

local function refreshVisuals()
    if visuals then
        pcall(function()
            if currentTargetType == "player" then 
                visuals:UpdateHighlights(currentTarget, lockedOn, function(ex) return getCachedSecondTarget(ex) end, isFriendly)
            else 
                visuals:UpdateHighlights(nil, false, function() return nil end, isFriendly) 
            end
        end)
    end
end

--==================================================
-- CAMERA UPDATE
--==================================================

local lastTargetPos = nil
local lastCameraCheck = 0
local forceCameraRef = nil -- Our own camera reference for force mode
local forceUpdateConnection = nil -- Secondary high-priority update
local lastPlayerLookDir = nil -- Track where player is trying to look for mouse resistance

-- Aggressive camera override for games with custom camera scripts
-- Only overrides ROTATION to look at target, keeps game's camera POSITION
local function forceCameraUpdate()
    if not forceCameraMode or not lockedOn or not currentTarget then return end
    if lockCamToggleEnabled and lockCamToggleActive then return end
    
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local myChar = localPlayer.Character
    if not myChar then return end
    
    local myRoot = getRootPart(myChar)
    local targetChar = (currentTargetType == "player") and (currentTarget and currentTarget.Character) or currentTarget
    local targetRoot = getRootPart(targetChar)
    
    if not myRoot or not targetRoot then return end
    
    -- Get current camera position (let game control this)
    local camPos = cam.CFrame.Position
    
    -- Calculate look direction to target
    local lookPos = targetRoot.Position + Vector3.new(0, lockHeightOffset, 0)
    
    if predictionEnabled and lastTargetPos then
        local vel = (targetRoot.Position - lastTargetPos)
        lookPos = lookPos + vel * predictionStrength
    end
    
    local desiredDir = lookPos - camPos
    local dir = desiredDir.Magnitude > 0.5 and desiredDir.Unit or lastLookDir
    lastLookDir = dir
    
    if reverseLockEnabled and reverseLockHeld then
        local baseDir = (lookPos - myRoot.Position)
        if baseDir.Magnitude > 0.001 then
            local horiz = Vector3.new(-baseDir.Unit.X, 0, -baseDir.Unit.Z)
            if horiz.Magnitude > 0.001 then dir = (horiz.Unit + Vector3.new(0, baseDir.Unit.Y, 0)).Unit end
        end
    end
    
    if perfectOffsetEnabled then
        local horiz = Vector3.new(dir.X, 0, dir.Z)
        if horiz.Magnitude > 0.001 then
            local right = horiz.Unit:Cross(Vector3.new(0, 1, 0))
            local off = (lookPos + right * PERFECT_OFFSET_STUDS) - camPos
            if off.Magnitude > 0.5 then dir = off.Unit end
        end
    end
    
    -- Mouse resistance: controls how much camera pulls toward target
    if mouseResistanceEnabled then
        local currentLook = cam.CFrame.LookVector
        local alpha = (mouseResistanceScale + 1) / 2
        local blendedDir = currentLook:Lerp(dir, alpha)
        if blendedDir.Magnitude > 0.001 then
            dir = blendedDir.Unit
        end
    end
    
    -- ONLY change rotation, keep the game's camera position intact
    local targetCF = CFrame.new(camPos, camPos + dir)
    cam.CFrame = targetCF
end

-- Setup/teardown force camera hooks
local function setupForceCameraHooks()
    -- Disconnect old hook if exists
    if forceUpdateConnection then
        pcall(function() forceUpdateConnection:Disconnect() end)
        forceUpdateConnection = nil
    end
    
    if forceCameraMode then
        -- Bind at HIGHEST priority (after everything else) to override game camera
        -- Using Camera.Value + 100 ensures we run AFTER most game scripts
        pcall(function()
            RunService:UnbindFromRenderStep("LockOnForceCamera")
        end)
        
        RunService:BindToRenderStep("LockOnForceCamera", Enum.RenderPriority.Camera.Value + 100, forceCameraUpdate)
        
        -- Also connect to RenderStepped as backup (runs every frame)
        forceUpdateConnection = RunService.RenderStepped:Connect(function()
            if forceCameraMode and lockedOn then
                task.defer(forceCameraUpdate) -- Defer to run after other RenderStepped connections
            end
        end)
        
        table.insert(allConnections, forceUpdateConnection)
    else
        pcall(function()
            RunService:UnbindFromRenderStep("LockOnForceCamera")
        end)
    end
end

local function updateCamera(dt)
    -- Get camera reference
    local cam = workspace.CurrentCamera
    
    -- Force camera mode: detect and handle camera changes
    if forceCameraMode then
        -- If camera is nil or destroyed, try to get it
        if not cam or not cam.Parent then
            cam = workspace.CurrentCamera
            camera = cam
        end
        
        if cam then
            -- Don't change camera type in force mode - let game keep its type
            -- We'll just override the CFrame directly
            camera = cam
        end
    end
    
    if not cam then cam = workspace.CurrentCamera; camera = cam; return end
    
    if not lockedOn or not currentTarget then
        invisibleTime, lastTargetPos = 0, nil
        updateNPCHighlight()
        if autoRelockPending and autoRelockEnabled then
            local t, ty = findBestTargetCombined(nil)
            if t then setNewTarget(t, ty) else refreshVisuals(); return end
        else refreshVisuals(); return end
    end

    local myChar = localPlayer.Character
    if not myChar then refreshVisuals(); return end
    
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = getRootPart(myChar)
    local targetChar = (currentTargetType == "player") and (currentTarget and currentTarget.Character) or currentTarget
    local targetRoot = getRootPart(targetChar)
    local targetHum = getHumanoid(targetChar)

    if not (myHum and myRoot and targetRoot and targetHum) then
        if autoSwapEnabled then 
            local t, ty = findBestTargetCombined(currentTarget)
            if t then setNewTarget(t, ty); return end 
        end
        unlockCamera(false); refreshVisuals(); return
    end

    if not isValidTarget(targetChar) then
        if autoSwapEnabled then 
            local t, ty = findBestTargetCombined(currentTarget)
            if t then setNewTarget(t, ty); return end 
        end
        unlockCamera(false); refreshVisuals(); return
    end

    if visibilityCheckEnabled and currentTargetType == "player" and targeting then
        local visible = pcall(function() return targeting:IsPlayerVisible(currentTarget) end)
        if visible then invisibleTime = 0 else
            invisibleTime = invisibleTime + dt
            if invisibleTime >= 2.5 then
                if autoSwapEnabled then 
                    local t, ty = findBestTargetCombined(currentTarget)
                    if t then setNewTarget(t, ty); return end 
                end
                unlockCamera(false); refreshVisuals(); return
            end
        end
    end

    if autoSwapEnabled and closeSwapEnabled then
        local b, ty = findBestTargetCombined(nil)
        if b and b ~= currentTarget then setNewTarget(b, ty) end
    end

    -- In force camera mode, we let the secondary hook handle the actual camera rotation
    -- This function just handles targeting logic
    if forceCameraMode then
        lastTargetPos = targetRoot.Position
        refreshVisuals()
        return
    end

    -- LockCamToggle: stay locked but free camera
    if lockCamToggleEnabled and lockCamToggleActive then
        lastTargetPos = targetRoot.Position
        pcall(function()
            if cam.CameraSubject ~= myHum then cam.CameraSubject = myHum end
            cam.CameraType = Enum.CameraType.Custom
        end)
        refreshVisuals()
        return
    end

    -- Normal mode: try to use Custom camera type
    pcall(function()
        if cam.CameraSubject ~= myHum then cam.CameraSubject = myHum end
        cam.CameraType = Enum.CameraType.Custom
    end)

    local camPos = cam.CFrame.Position
    local lookPos = targetRoot.Position + Vector3.new(0, lockHeightOffset, 0)

    if predictionEnabled and lastTargetPos then
        local vel = (targetRoot.Position - lastTargetPos) / math.max(dt, 0.001)
        lookPos = lookPos + vel * predictionStrength
    end
    lastTargetPos = targetRoot.Position

    local desiredDir = lookPos - camPos
    local dir = desiredDir.Magnitude > 0.5 and desiredDir.Unit or lastLookDir
    lastLookDir = dir

    if reverseLockEnabled and reverseLockHeld then
        local baseDir = (lookPos - myRoot.Position)
        if baseDir.Magnitude > 0.001 then
            local horiz = Vector3.new(-baseDir.Unit.X, 0, -baseDir.Unit.Z)
            if horiz.Magnitude > 0.001 then dir = (horiz.Unit + Vector3.new(0, baseDir.Unit.Y, 0)).Unit end
        end
    end

    if perfectOffsetEnabled then
        local horiz = Vector3.new(dir.X, 0, dir.Z)
        if horiz.Magnitude > 0.001 then
            local right = horiz.Unit:Cross(Vector3.new(0, 1, 0))
            local off = (lookPos + right * PERFECT_OFFSET_STUDS) - camPos
            if off.Magnitude > 0.5 then dir = off.Unit end
        end
    end

    -- Mouse resistance: controls how much camera pulls toward target
    -- Scale: -1 to 1
    -- +1 = full lock on target (100% pull)
    -- 0 = balanced (50% pull)
    -- -1 = minimal lock (0% pull, almost free aim)
    if mouseResistanceEnabled then
        local currentLook = cam.CFrame.LookVector
        -- Convert scale from -1,1 to 0,1 for lerp alpha
        -- resistance 1 -> alpha 1 (full target)
        -- resistance 0 -> alpha 0.5 (balanced)
        -- resistance -1 -> alpha 0 (full player control)
        local alpha = (mouseResistanceScale + 1) / 2
        local blendedDir = currentLook:Lerp(dir, alpha)
        if blendedDir.Magnitude > 0.001 then
            dir = blendedDir.Unit
        end
    end

    local targetCF = CFrame.new(camPos, camPos + dir)
    cam.CFrame = targetCF
    refreshVisuals()
end

RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, updateCamera)

