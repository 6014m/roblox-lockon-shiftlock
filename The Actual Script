local PARENT = nil

local function setupGuiParent()
    -- Method 1: gethui (best for exploits)
    if gethui then
        pcall(function() PARENT = gethui() end)
        if PARENT then return end
    end
    
    if get_hidden_gui then
        pcall(function() PARENT = get_hidden_gui() end)
        if PARENT then return end
    end
    
    -- Method 2: syn.protect_gui
    if syn and syn.protect_gui then
        pcall(function()
            local m = Instance.new("ScreenGui")
            m.Name = GUI_NAME .. "_container"
            syn.protect_gui(m)
            m.Parent = CoreGui
            PARENT = m
        end)
        if PARENT then return end
    end
    
    -- Method 3: Direct CoreGui
    pcall(function()
        local m = Instance.new("ScreenGui")
        m.Name = GUI_NAME .. "_container"
        m.Parent = CoreGui
        PARENT = m
    end)
    if PARENT then return end
    
    -- Method 4: RobloxGui
    if CoreGui:FindFirstChild("RobloxGui") then 
        PARENT = CoreGui.RobloxGui
        return 
    end
    
    -- Method 5: PlayerGui fallback
    PARENT = localPlayer:WaitForChild("PlayerGui")
end

