    if data.kb_LockOnPlus and Enum.KeyCode[data.kb_LockOnPlus] then keybinds.LockOnPlus = Enum.KeyCode[data.kb_LockOnPlus] end
    
    -- Old formats
    if data.keybindLockOn and Enum.KeyCode[data.keybindLockOn] then keybinds.LockOn = Enum.KeyCode[data.keybindLockOn] end
    if data.keybindSwapTarget and Enum.KeyCode[data.keybindSwapTarget] then keybinds.SwapTarget = Enum.KeyCode[data.keybindSwapTarget] end
