    customShiftlockEnabled = true
    if shiftLock then pcall(function() shiftLock:Enable() end) end
end

local function disableCustomShiftlock()
    if not customShiftlockEnabled then return end
    customShiftlockEnabled = false
    if shiftLock then pcall(function() shiftLock:Disable() end) end
end

