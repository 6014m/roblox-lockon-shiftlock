local function getBestTarget(exclude) return targeting and targeting:GetBestTarget(exclude) end

-- Find target closest to mouse cursor
local function findMouseTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local myRoot = getRootPart(localPlayer.Character)
    if not myRoot or not camera then return nil, nil end
    
    local best, bestType, bestDist = nil, nil, math.huge
    
    -- Check players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and not isFriendly(plr) then
            local char = plr.Character
            local root = getRootPart(char)
            if root and isValidTarget(char) then
                -- Get screen position of target
                local screenPos, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    local worldDist = (root.Position - myRoot.Position).Magnitude
                    
                    -- Check range limit
                    if rangeLimit == 0 or worldDist <= rangeLimit then
                        -- Check realistic mode (front only)
                        local valid = true
                        if realisticEnabled then
                            local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                            if dot < 0 then valid = false end
                        end
                        
                        if valid and screenDist < bestDist then
                            bestDist, best, bestType = screenDist, plr, "player"
                        end
                    end
                end
            end
        end
    end
    
    -- Check NPCs if enabled
    if npcModeEnabled then
        for _, data in ipairs(findNPCsNow()) do
            local root = getRootPart(data.model)
            if root then
                local screenPos, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    local valid = true
                    if realisticEnabled then
                        local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                        if dot < 0 then valid = false end
                    end
                    
                    if valid and screenDist < bestDist then
                        bestDist, best, bestType = screenDist, data.model, "npc"
                    end
                end
            end
        end
    end
    
    return best, bestType
end

local function findBestTargetCombined(exclude)
    local myRoot = getRootPart(localPlayer.Character)
    if not myRoot then return nil, nil end
    local best, bestType, bestDist = nil, nil, math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr ~= exclude and not isFriendly(plr) then
            local char, root = plr.Character, getRootPart(plr.Character)
            if root and isValidTarget(char) then
                local dist = (root.Position - myRoot.Position).Magnitude
                if (rangeLimit == 0 or dist <= rangeLimit) and dist < bestDist then
                    local valid = true
                    if realisticEnabled then
                        local dot = (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector)
                        if dot < 0 then valid = false end
                    end
                    if valid then bestDist, best, bestType = dist, plr, "player" end
                end
            end
        end
    end
    
    if npcModeEnabled then
        for _, data in ipairs(findNPCsNow()) do
            if data.model ~= exclude and data.distance < bestDist then
                local root = getRootPart(data.model)
                if root and (not realisticEnabled or (root.Position - myRoot.Position).Unit:Dot(myRoot.CFrame.LookVector) >= 0) then
                    bestDist, best, bestType = data.distance, data.model, "npc"
                end
            end
        end
    end
    
    return best, bestType
end

local function refreshVisuals()
    if visuals then
        pcall(function()
            if currentTargetType == "player" then 
                visuals:UpdateHighlights(currentTarget, lockedOn, function(ex) return getBestTarget(ex) end, isFriendly)
            else 
                visuals:UpdateHighlights(nil, false, function() return nil end, isFriendly) 
            end
        end)
    end
end

